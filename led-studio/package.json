{
  "name": "led-show-studio",
  "version": "0.1.0",
  "description": "LED Show Studio — Electron + React desktop app for ESP32-S3 WS2812B timecode LED shows",
  "main": "./out/main/index.js",
  "author": "LED Show Studio",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win --x64",
    "preview": "electron-vite preview",
    "fw:build": "../scripts/fw.sh build",
    "fw:upload": "../scripts/fw.sh upload",
    "fw:clean": "../scripts/fw.sh clean",
    "fw:envs": "../scripts/fw.sh envs",
    "test": "vitest run",
    "test:ui": "vitest run tests/ui",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest",
    "rebuild": "electron-rebuild -f -w serialport",
    "postinstall": "electron-rebuild -f -w serialport || true"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "serialport": "^13.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
